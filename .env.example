# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Settings > API. Used by the seed script, never by the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Settings > Database > connection string (URI). Used by `npm run db:migrate`.
SUPABASE_DB_URL=

# Optional. Origin used in auth email links; inferred from the request when unset.
NEXT_PUBLIC_SITE_URL=
